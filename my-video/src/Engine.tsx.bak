import React, { useEffect, useMemo, useState } from "react";
import * as THREE from "three";
import { ThreeCanvas } from "@remotion/three";
import { useThree } from "@react-three/fiber";
import { useGLTF } from "@react-three/drei";
import * as SkeletonUtils from "three/examples/jsm/utils/SkeletonUtils.js";
import {
  AbsoluteFill,
  Audio,
  continueRender,
  delayRender,
  interpolate,
  staticFile,
  useCurrentFrame,
  useVideoConfig,
} from "remotion";
import { story } from "./story";

const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
const ease = (t: number) => t * t * (3 - 2 * t);
const lerp3 = (a: number[], b: number[], t: number) =>
  new THREE.Vector3(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t);

const charState = (c: any, f: number) => {
  const s = c.timeline.find((x: any) => f >= x.from && f < x.to) ?? c.timeline[c.timeline.length - 1];
  const t = clamp01((f - s.from) / Math.max(1, s.to - s.from));
  const dx = s.end[0] - s.start[0];
  const dz = s.end[2] - s.start[2];
  const moving = Math.abs(dx) + Math.abs(dz) > 0.01;
  return { s, p: lerp3(s.start, s.end, t), rotY: moving ? Math.atan2(dx, dz) : s.rotY ?? 0 };
};

const Loading: React.FC = () => {
  const [handle] = useState(() => delayRender("loading model"));
  useEffect(() => () => continueRender(handle), [handle]);
  return null;
};

const Actor: React.FC<{ c: any; frame: number; fps: number }> = ({ c, frame, fps }) => {
  const gltf = useGLTF(staticFile(c.model));
  const rig = useMemo(() => {
    const root: THREE.Object3D = SkeletonUtils.clone(gltf.scene);
    const paint = (m: any) => {
      const n = m.clone();
      n.map = null;
      n.color.set(c.tint);
      n.roughness = 0.6;
      n.metalness = 0;
      return n;
    };
    root.traverse((o: any) => {
      if (!o.isMesh) return;
      o.castShadow = true;
      o.frustumCulled = false;
      if (c.tint) o.material = Array.isArray(o.material) ? o.material.map(paint) : paint(o.material);
    });
    return { root, mixer: new THREE.AnimationMixer(root) };
  }, [gltf.scene]);
  const { p, rotY, s } = charState(c, frame);
  const clip =
    gltf.animations.find((a) => a.name.toLowerCase() === String(s.clip).toLowerCase()) ??
    gltf.animations[0];
  rig.mixer.stopAllAction();
  rig.mixer.clipAction(clip).play();
  rig.mixer.setTime(((frame - s.from) / fps) * (s.speed ?? 1));
  return (
    <group position={[p.x, p.y, p.z]} rotation={[0, rotY, 0]} scale={c.scale ?? 1}>
      <primitive object={rig.root} />
    </group>
  );
};

const Rig: React.FC<{ frame: number }> = ({ frame }) => {
  const { camera } = useThree();
  const sh: any = story.shots.find((s: any) => frame >= s.from && frame < s.to) ?? story.shots[story.shots.length - 1];
  const t = ease(clamp01((frame - sh.from) / Math.max(1, sh.to - sh.from)));
  const pos = lerp3(sh.pos, sh.posEnd ?? sh.pos, t);
  const tgt =
    typeof sh.look === "string"
      ? charState(story.characters.find((c: any) => c.id === sh.look), frame).p.add(
          new THREE.Vector3(...((sh.lookOffset ?? [0, 1.1, 0]) as [number, number, number]))
        )
      : lerp3(sh.look, sh.lookEnd ?? sh.look, t);
  camera.position.copy(pos);
  camera.lookAt(tgt);
  const cam = camera as THREE.PerspectiveCamera;
  const fov = sh.fov ?? 40;
  if (cam.fov !== fov) {
    cam.fov = fov;
    cam.updateProjectionMatrix();
  }
  return null;
};
  <mesh position={p as any} castShadow receiveShadow>
    <boxGeometry args={s as any} />
    <meshStandardMaterial color={c} roughness={0.9} emissive={glow ? c : "#000000"} emissiveIntensity={glow ?? 0} />
  </mesh>
);

const roofGeo = (() => {
  const sh = new THREE.Shape();
  sh.moveTo(-4.6, 0);
  sh.lineTo(4.6, 0);
  sh.lineTo(0, 2.6);
  sh.lineTo(-4.6, 0);
  return new THREE.ExtrudeGeometry(sh, { depth: 8, bevelEnabled: false });
})();

const House: React.FC<{ x: number; z: number; side: number; wall: string; roof: string }> = ({ x, z, side, wall, roof }) => {
  const lit = (i: number, j: number) => (Math.abs(Math.round(z)) + i * 3 + j * 5) % 3 !== 0;
  return (
    <group position={[x, 0, z]} rotation={[0, side < 0 ? Math.PI / 2 : -Math.PI / 2, 0]}>
      <Box p={[0, 2.75, 0]} s={[8, 5.5, 7]} c={wall} />
      <mesh geometry={roofGeo} position={[0, 5.5, -4]} castShadow>
        <meshStandardMaterial color={roof} roughness={0.95} />
      </mesh>
      <Box p={[0, 1.2, 3.52]} s={[1.3, 2.4, 0.1]} c="#3a2b22" />
      {[-2.6, 2.6].flatMap((wx, i) =>
        [1.9, 4.2].map((wy, j) => (
          <Box key={i + "-" + j} p={[wx, wy, 3.52]} s={[1.3, 1.2, 0.1]} c={lit(i, j) ? "#ffd68a" : "#2a3340"} glow={lit(i, j) ? 1 : 0.1} />
        ))
      )}
    </group>
  );
};

const Lamp: React.FC<{ x: number; z: number }> = ({ x, z }) => {
  const d = x > 0 ? -1 : 1;
  return (
    <group position={[x, 0, z]}>
      <Box p={[0, 2.6, 0]} s={[0.12, 5.2, 0.12]} c="#1d1d1d" />
      <Box p={[d * 0.6, 5.2, 0]} s={[1.2, 0.1, 0.1]} c="#1d1d1d" />
      <mesh position={[d * 1.1, 5.1, 0]}>
        <sphereGeometry args={[0.2, 12, 8]} />
        <meshStandardMaterial color="#fff2c8" emissive="#ffdd88" emissiveIntensity={2} />
      </mesh>
    </group>
  );
};

const Tree: React.FC<{ x: number; z: number; k: number }> = ({ x, z, k }) => (
  <group position={[x, 0, z]} scale={0.9 + k * 0.5}>
    <Box p={[0, 1.4, 0]} s={[0.4, 2.8, 0.4]} c="#4b3626" />
    <mesh position={[0, 3.9, 0]} castShadow>
      <icosahedronGeometry args={[1.7, 1]} />
      <meshStandardMaterial color="#58703a" roughness={1} flatShading />
    </mesh>
    <mesh position={[0.9, 3.3, 0.4]} castShadow>
      <icosahedronGeometry args={[1.1, 1]} />
      <meshStandardMaterial color="#4f6633" roughness={1} flatShading />
    </mesh>
  </group>
);

const Street: React.FC = () => {
  const items = useMemo(() => {
    const out = { houses: [] as any[], lamps: [] as any[], trees: [] as any[] };
    const walls = ["#4a6073", "#d8cdb2", "#a9a8a0", "#7b8a78", "#c9b79c"];
    const roofs = ["#2e2a2a", "#3b3434", "#2a2f33"];
    for (let i = 0; i < 9; i++) {
      const z = 20 - i * 14;
      out.houses.push({ x: -12.5, z, side: -1, wall: walls[i % 5], roof: roofs[i % 3] });
      out.houses.push({ x: 12.5, z: z - 5, side: 1, wall: walls[(i + 2) % 5], roof: roofs[(i + 1) % 3] });
      out.lamps.push({ x: -3.2, z: z - 3 });
      out.lamps.push({ x: 3.2, z: z - 10 });
      out.trees.push({ x: -5.8, z: z - 7, k: ((i * 37) % 10) / 10 });
      out.trees.push({ x: 5.8, z: z - 2, k: ((i * 53) % 10) / 10 });
    }
    return out;
  }, []);
  return (
    <group>
      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -0.01, -70]} receiveShadow>
        <planeGeometry args={[300, 320]} />
        <meshStandardMaterial color="#74803f" roughness={1} />
      </mesh>
      <Box p={[0, 0.02, -70]} s={[6, 0.04, 260]} c="#3d3d3d" />
      <Box p={[-3.9, 0.02, -70]} s={[1.8, 0.04, 260]} c="#b9b4a8" />
      <Box p={[3.9, 0.02, -70]} s={[1.8, 0.04, 260]} c="#b9b4a8" />
      {Array.from({ length: 40 }, (_, i) => (
        <Box key={i} p={[0, 0.045, 50 - i * 6]} s={[0.15, 0.01, 2.5]} c="#d9b44a" />
      ))}
      {items.houses.map((h, i) => <House key={i} {...h} />)}
      {items.lamps.map((l, i) => <Lamp key={i} {...l} />)}
      {items.trees.map((t, i) => <Tree key={i} {...t} />)}
    </group>
  );
};

const Sun: React.FC<{ frame: number }> = ({ frame }) => {
  const target = useMemo(() => new THREE.Object3D(), []);
  const hero = charState(story.characters[0], frame).p;
  target.position.copy(hero);
  return (
    <>
      <primitive object={target} />
      <directionalLight
        position={[hero.x - 14, hero.y + 16, hero.z + 12]}
        target={target}
        color={story.env.sun}
        intensity={2.2}
        castShadow
        shadow-mapSize={[2048, 2048]}
        shadow-bias={-0.0004}
        shadow-normalBias={0.03}
        shadow-camera-near={1}
        shadow-camera-far={70}
        shadow-camera-left={-14}
        shadow-camera-right={14}
        shadow-camera-top={14}
        shadow-camera-bottom={-14}
      />
    </>
  );
};

